 projects are indeed made by communities","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"jdme7nXNmb"}],"identifier":"id-1-3-community-projects-are-indeed-made-by-communities","label":"1.3 Community projects are indeed made by communities","html_id":"id-1-3-community-projects-are-indeed-made-by-communities","implicit":true,"key":"iF4dWE0RWZ"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Contributions can take many forms. In academic projects, it is common that the Principal Investigator (PI) of the project may provide more conceptual contributions and guidance than code/documentation contributions. Although, this is not the norm and it is changing with younger PIs and projects.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"Ht3FpBFnpL"}],"key":"BoRHi7NgCM"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Let’s peek at one example of a ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"gqzrqUX96d"},{"type":"link","url":"https://github.com/CliMA/ClimaCore.jl/graphs/contributors","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Contributors page","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"SJTVXce0Mz"}],"urlSource":"https://github.com/CliMA/ClimaCore.jl/graphs/contributors","error":true,"key":"CrUMpFxOTm"},{"type":"text","value":". You can filter contributors by periods of time or by tipe of contributions. GitHub uses three contribution categories: Commits (identifieble with PRs when people squash/rebase PRs to a single commit after celaning up their work - this is very common, to keep the ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"eNdlvlfVkV"},{"type":"inlineCode","value":"main","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"mjHwO6ZiR4"},{"type":"text","value":" branch as clean as possible), code Additions, and Deletions.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"De61jstgQl"}],"key":"YRfboIqPNt"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":57,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"You can check contributions even by Command Line, via ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"F96ENwqkL6"},{"type":"inlineCode","value":"git","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"Nw0Rs7ZnyS"},{"type":"text","value":" commands, not necessarily using the GitHub/GitLab web iterface.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"LS62rkmrEi"}],"key":"QVQxNrH6pb"}],"key":"YtsidnoDDf"},{"type":"listItem","spread":true,"position":{"start":{"line":59,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"You can check how “big” or “influential” each addition/commit to the codebase is, by running, e.g., ","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"g3kWAU0COQ"},{"type":"inlineCode","value":"git log --shortstat","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"N3f14G0oII"},{"type":"text","value":".","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"IBiIbkgFVv"}],"key":"LrxJRDLtjp"}],"key":"Hd7jntegrM"},{"type":"listItem","spread":true,"position":{"start":{"line":61,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Hopefully, once you make a contribution, you will be welcomed by helpful and constructive feedback (via PR/MR Reviews) and the code maintainers can accept, partially accept or decline some of your proposed changes.","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"xxAJ9Ld4Fs"}],"key":"wfsmDVy0UF"}],"key":"IeVxh7sh0B"},{"type":"listItem","spread":true,"position":{"start":{"line":63,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Do not fall in the trap of ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"fPTImkld5E"},{"type":"link","url":"https://osf.io/preprints/psyarxiv/8k5a4","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Code Review Anxiety","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"qntjKvpXVl"}],"urlSource":"https://osf.io/preprints/psyarxiv/8k5a4","key":"cWXwauETqs"},{"type":"text","value":"! In general, code reviews are a good way of learning how to accept constructive criticism.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"fe7cS5oGVf"}],"key":"BqVSQSeZod"}],"key":"Ul5vlfsQml"}],"key":"x1hR5Fa7MC"},{"type":"heading","depth":2,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"1.4 Best Practices and Resources","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"oPReMRixCU"}],"identifier":"id-1-4-best-practices-and-resources","label":"1.4 Best Practices and Resources","html_id":"id-1-4-best-practices-and-resources","implicit":true,"key":"mOoUQ7YhLl"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"This section does not represent an exhaustive list of what constitutes Best Practices in Community Projects, but here are some of the most important aspects:","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"JYYK3IubuI"}],"key":"D6D1bmvtdz"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":69,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":69,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Code Quality: There are metrics that can define code quality. Tracking code quality helps identify potential issues early in development, preventing them from becoming critical problems later. Some of the metrics include:","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"DlyOKKjJHt"}],"key":"r3iNu2aa34"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":70,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cyclomatic complexity: measures how complex a code is based on the number of decision points (linearly independent paths) in the program. Simply, it counts the number of decision paths (branching) through your code.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"znZRdF2DRr"}],"key":"Q7p5a8vZqQ"}],"key":"VUQjehO0u0"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Code Churn: how much code is added, modified, or deleted over time. Of course, younger codebases tend to be much less stable.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"aN4PWzuZMF"}],"key":"t0YciWWcyf"}],"key":"XhogsfQaAu"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Code Coverage: quantifies the percentage of the codebase covered by automated tests (more below).","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"wUjkJIaPkL"}],"key":"gb2ITbfhAt"}],"key":"KHXdqOsvMA"}],"key":"hwSYLxy58Z"}],"key":"WV5wrvOfuN"},{"type":"listItem","spread":true,"position":{"start":{"line":74,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"Documentation: By far, the most underrated, yet invaluable part in software engineering. Good documentation plays an important role during the software development lifecycle, as it records knowledge during different stages of the development cycle and eases the transfer of knowledge when team dynamics and code contributors change over time (think of people leaving/joining the project-this happens a lot, especially in Academia). A well documented code is easy for other developers or new users to understand and use.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"vTgpFey6jg"}],"key":"Wz8XJLJwtc"}],"key":"Y9EeSJJTHf"},{"type":"listItem","spread":true,"position":{"start":{"line":76,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Examples/tutorials: It is a good practice to have a dedicated directory in your codebase, often called ","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"fKbRoAin2Q"},{"type":"inlineCode","value":"examples/","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"M1Vi1u63v0"},{"type":"text","value":" that comprises simple examples and/or tutorials so that new users can learn about the functionality of the package/library in question. It is often the case that entry-level contributions from newcomers are examples, often expanding existing examples or taking them as templates.","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"rAD3lASgIe"}],"key":"GfmtbhJfSg"}],"key":"CjUnXa2vZN"},{"type":"listItem","spread":true,"position":{"start":{"line":78,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Automated testing: The process of ensuring that a software product is meeting its requirements. Testing suites help to avoid defects and verify correctness. An example of a ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"mGCyQvIKh3"},{"type":"link","url":"https://gitlab.com/libceed/libCEED/-/pipelines/1497542437","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"testing suite","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"G0at5lAMiw"}],"urlSource":"https://gitlab.com/libceed/libCEED/-/pipelines/1497542437","key":"VkoMLHPECZ"},{"type":"text","value":". Automated testing can be composed of multiple parts:","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"ga82kWNwHR"}],"key":"lEpEUeguDF"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":79,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Unit tests: they are intentionally limited in scope, testing one function/functionality at a time (e.g., only a mathamtical operator at a time).","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"gGOUHtUwNI"}],"key":"seLHKZgpe8"}],"key":"Ac7F06qwfY"},{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Integration tests: they can include more complex scenarios (think of more physically-relevant or engineering problems). Usually integration tests have an output different from just Pass/Fail (can include graphs, images, videos, numerical quantities of interest, etc.). Here an ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"gwti2AQ4Kv"},{"type":"link","url":"https://buildkite.com/clima/climacore-ci/builds/4543#0192929b-eec3-4163-90dc-b4943dff69d5","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"example","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"SoY31RC6dV"}],"urlSource":"https://buildkite.com/clima/climacore-ci/builds/4543#0192929b-eec3-4163-90dc-b4943dff69d5","key":"pqWMs5Rs5A"},{"type":"text","value":".","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"uW4jwyvDYF"}],"key":"LXA8JeTuct"}],"key":"SUCSd9a6ll"}],"key":"yWXIXBaCat"}],"key":"iUl9EzYpoL"},{"type":"listItem","spread":true,"position":{"start":{"line":82,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Continuous Integration/Continuous Development or Deployment (CI/CD): Testing that is maximally integrated with code commits to promote efficient co-development and well-defined delivery criteria. Every time someone wants to merge changes into a codebase, if the project has CI/CD infrastructure in place, they will have to pass all tests before the changes can be merged into the upstream codebase.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"KRzHKDI1OZ"}],"key":"E9znUVErLh"}],"key":"TrrQt95qcu"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Code Coverage: the percentage of the codebase that is exercised by the test suite. The higher the better code quality is, generally. Although, developers need to make sure that the tests in the test suite cover all possible edge cases and (mis)uses of the software.","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"n7vlD0DoZZ"}],"key":"G0nlwgzGI1"}],"key":"FuQ9vIybwb"},{"type":"listItem","spread":true,"position":{"start":{"line":86,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Do not unintentionally make your code more obscure or ","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"yNEr7tQmDl"},{"type":"link","url":"https://en.wikipedia.org/wiki/Obfuscation_(software)","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"obfuscated","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"dG9mz0qcL9"}],"urlSource":"https://en.wikipedia.org/wiki/Obfuscation_(software)","data":{"page":"Obfuscation_(software)","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"ELZPqaD0SF"},{"type":"text","value":" than it should be.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"AoeRBN8vkL"}],"key":"nS5qj7NVoF"}],"key":"tqPJN6R4hh"},{"type":"listItem","spread":true,"position":{"start":{"line":88,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"A useful resource for Scientific Software: ","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"Wtxjvw6lZs"},{"type":"link","url":"https://bssw.io/","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"text","value":"Better Scientific Software","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"k1Omi00aQA"}],"urlSource":"https://bssw.io/","key":"k2RSWiAGpO"},{"type":"text","value":".","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"ADDZOjjzm1"}],"key":"LTJioxocIg"}],"key":"TP1qkg7KGn"},{"type":"listItem","spread":true,"position":{"start":{"line":90,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"Software Sustainability: The ability of software to continue or evolve over time (or even support itself financially).","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"WfytsXZ3bM"}],"key":"r2IgAD0qOF"}],"key":"i0NV4qoz4M"},{"type":"listItem","spread":true,"position":{"start":{"line":92,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Avoid maintenance burdens: this can present itself with code duplications, outdated examples/tutorials or duplication between snippets of code and documentation.","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"MH2eRZlfnQ"}],"key":"WDc04KtQnK"}],"key":"kiUYgBhMro"},{"type":"listItem","spread":true,"position":{"start":{"line":94,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"Code Security: How resistant the code is to attacks and risks? Usually this is not an issue for numerical/scientific software.","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"OgnbHia0d1"}],"key":"sydOSc4e7j"}],"key":"AfeJ16jW9S"}],"key":"F4vmsH40zq"}],"key":"JdBVOixYGM"}],"key":"pllzfqLTM1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"2) The Linux Filesystem and commands","url":"/lectures/module1-2-linux","group":"Computational Methods for Scientists Fall 26"},"next":{"title":"4) Intro to C","url":"/lectures/module2-1-intro-to-c","group":"Computational Methods for Scientists Fall 26"}}},"domain":"http://localhost:3000"}